rules_version = '2';

// Regras de segurança · Stéfany Medeiros Trancista
// Perfis: proprietária (dona), trancista parceira, recepção e contador(a).
// O servidor recusa qualquer leitura ou gravação fora do perfil, mesmo que alguém altere o site.

service cloud.firestore {
  match /databases/{database}/documents {

    function logada() { return request.auth != null; }
    function caminho(c, id) { return /databases/$(database)/documents/$(c)/$(id); }

    function dona() {
      return logada()
        && exists(caminho('sistema', 'acesso'))
        && request.auth.uid in get(caminho('sistema', 'acesso')).data.donas;
    }
    function perfil() { return get(caminho('equipe', request.auth.uid)).data; }
    function eh(papel) {
      return logada()
        && exists(caminho('equipe', request.auth.uid))
        && perfil().ativo == true
        && perfil().papel == papel;
    }
    function atendimento() { return dona() || eh('parceira') || eh('recepcao'); }
    function saude()       { return dona() || eh('parceira'); }
    function financas()    { return dona() || eh('contador'); }

    // Quem é a proprietária. Só pode ser criado uma vez, pela própria conta.
    match /sistema/acesso {
      allow read: if logada();
      allow create: if logada()
        && !exists(caminho('sistema', 'acesso'))
        && request.resource.data.donas == [request.auth.uid];
      allow update, delete: if dona();
    }

    // Perfis da equipe: só a proprietária define. Cada pessoa lê apenas o próprio.
    match /equipe/{uid} {
      allow read: if dona() || (logada() && request.auth.uid == uid);
      allow write: if dona();
    }

    // Pedidos de acesso: cada pessoa cria o seu; só a proprietária vê todos.
    match /pedidos/{uid} {
      allow read: if dona() || (logada() && request.auth.uid == uid);
      allow create, update: if logada() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'nome', 'pedidoEm']);
      allow delete: if dona();
    }

    // Atendimento do dia a dia
    match /clientes/{id} {
      allow read, create, update: if atendimento();
      allow delete: if dona();
    }
    match /agenda/{id} {
      allow read: if atendimento() || eh('contador');
      allow create, update: if atendimento();
      allow delete: if dona();
    }
    match /espera/{id}  { allow read, write: if atendimento(); }
    match /ideias/{id}  { allow read, write: if atendimento(); }
    match /pacotes/{id} {
      allow read: if atendimento() || eh('contador');
      allow create, update: if atendimento();
      allow delete: if dona();
    }
    match /vales/{id} {
      allow read: if atendimento() || eh('contador');
      allow create, update: if atendimento();
      allow delete: if dona();
    }

    // Dados de saúde (LGPD, dado sensível): só proprietária e trancista parceira.
    match /anamneses/{id} {
      allow read, create, update: if saude();
      allow delete: if dona();
    }

    // Estoque: proprietária e trancista parceira.
    match /estoque/{id} {
      allow read, create, update: if saude();
      allow delete: if dona();
    }

    // Aceites de contratos: não podem ser alterados depois de registrados.
    // Termos de anamnese só são visíveis para quem pode ver dados de saúde.
    match /aceites/{id} {
      allow read: if saude() || (eh('recepcao') && resource.data.tipo in ['servico', 'politica']);
      allow create: if saude() || (eh('recepcao') && request.resource.data.tipo in ['servico', 'politica']);
      allow update: if false;
      allow delete: if dona();
    }

    // Tabela de preços e configurações públicas: todos leem, só a proprietária altera.
    match /servicos/{id} {
      allow read: if atendimento() || eh('contador');
      allow write: if dona();
    }
    match /publico/{id} {
      allow read: if atendimento() || eh('contador');
      allow write: if dona();
    }

    // Finanças: proprietária altera; contador(a) só lê.
    match /lancamentos/{id} { allow read: if financas(); allow write: if dona(); }
    match /contas/{id}      { allow read: if financas(); allow write: if dona(); }
    match /privado/{id}     { allow read: if financas(); allow write: if dona(); }

    // ===== Catálogo e vitrine: públicos para leitura, só a proprietária altera =====
    match /catalogo/{id} { allow read: if true; allow write: if dona(); }
    match /catalogoFotos/{id} {
      allow read: if true;
      allow create, update: if dona() && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      allow delete: if dona();
    }
    match /vitrine/{id} { allow read: if true; allow write: if dona(); }

    // ===== Contrato por link =====
    // Quem tem o link lê o contrato. A cliente só pode aceitar uma vez, dentro da validade,
    // sem alterar nenhum outro campo. Depois do aceite, a equipe só marca "registrado" e "visto".
    match /contratosLink/{token} {
      allow get: if true;
      allow list: if atendimento();
      allow create: if atendimento() && request.resource.data.status == 'pendente';
      allow update: if (atendimento() && (resource.data.status == 'pendente'
            ? request.resource.data.status == 'pendente'
            : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrado', 'visto'])))
        || (resource.data.status == 'pendente'
            && request.time < resource.data.expiraEm
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'aceite'])
            && request.resource.data.status == 'aceito'
            && request.resource.data.aceite.keys().hasOnly(['nome', 'cpf', 'meio', 'assinatura', 'em', 'dispositivo'])
            && request.resource.data.aceite.em == request.time
            && request.resource.data.aceite.nome is string
            && request.resource.data.aceite.nome.size() >= 3 && request.resource.data.aceite.nome.size() <= 120
            && request.resource.data.aceite.cpf is string && request.resource.data.aceite.cpf.size() <= 20
            && request.resource.data.aceite.dispositivo is string && request.resource.data.aceite.dispositivo.size() <= 200
            && request.resource.data.aceite.meio in ['assinatura', 'concordo']
            && (request.resource.data.aceite.meio == 'concordo'
                || (request.resource.data.aceite.assinatura is string && request.resource.data.aceite.assinatura.size() < 250000)));
      allow delete: if dona();
    }

    // ===== Espaço da cliente =====
    // O documento só é lido por quem tem o link (token secreto). Não é possível listar os espaços.
    match /portal/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if atendimento();
      match /proximos/{agId} {
        allow read: if true;
        allow create, delete: if atendimento();
        // A cliente só cancela antes do prazo, e só altera o campo de cancelamento.
        allow update: if atendimento()
          || (resource.data.cancelado == false
              && request.time < resource.data.limiteCancelamento
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelado', 'canceladoEm'])
              && request.resource.data.cancelado == true
              && request.resource.data.canceladoEm == request.time);
      }
    }

    // Pedidos de cancelamento feitos pela cliente, conferidos contra o prazo no servidor.
    match /solicitacoes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['token', 'agendaId', 'tipo', 'criadoEm', 'motivo'])
        && request.resource.data.tipo == 'cancelamento'
        && request.resource.data.criadoEm == request.time
        && request.resource.data.token is string && request.resource.data.token.size() <= 64
        && request.resource.data.agendaId is string && request.resource.data.agendaId.size() <= 64
        && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 300
        && exists(/databases/$(database)/documents/portal/$(request.resource.data.token)/proximos/$(request.resource.data.agendaId))
        && get(/databases/$(database)/documents/portal/$(request.resource.data.token)/proximos/$(request.resource.data.agendaId)).data.cancelado == false
        && request.time < get(/databases/$(database)/documents/portal/$(request.resource.data.token)/proximos/$(request.resource.data.agendaId)).data.limiteCancelamento;
      allow read, update: if atendimento();
      allow delete: if dona();
    }

    // Qualquer outro caminho é bloqueado.
    match /{documento=**} { allow read, write: if false; }
  }
}
