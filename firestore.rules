rules_version = '2';

// Regras de segurança · Stéfany Medeiros Trancista
// Perfis: proprietária (dona), diretor (parte administrativa: finanças, contratos e equipe, sem dados de saúde),
// trancista parceira, recepção e contador(a).
// O servidor recusa qualquer leitura ou gravação fora do perfil, mesmo que alguém altere o site.

service cloud.firestore {
  match /databases/{database}/documents {

    function logada() { return request.auth != null; }
    function caminho(c, id) { return /databases/$(database)/documents/$(c)/$(id); }

    function dona() {
      return logada()
        && exists(caminho('sistema', 'acesso'))
        && request.auth.uid in get(caminho('sistema', 'acesso')).data.donas;
    }
    function perfil() { return get(caminho('equipe', request.auth.uid)).data; }
    function eh(papel) {
      return logada()
        && exists(caminho('equipe', request.auth.uid))
        && perfil().ativo == true
        && perfil().papel == papel;
    }
    function atendimento() { return dona() || eh('parceira') || eh('recepcao'); }
    function saude()       { return dona() || eh('parceira'); }
    function financas()    { return dona() || eh('contador') || eh('diretor'); }
    function finEdita()    { return dona() || eh('diretor'); }
    function contratos()   { return atendimento() || eh('diretor'); }
    // O diretor aprova e altera só estes perfis (nunca o próprio, nem outro diretor, nem proprietária).
    function papelComum(d) { return d.papel in ['parceira', 'recepcao', 'contador']; }

    // Quem é a proprietária. Só pode ser criado uma vez, pela própria conta.
    match /sistema/acesso {
      allow read: if logada();
      allow create: if logada()
        && !exists(caminho('sistema', 'acesso'))
        && request.resource.data.donas == [request.auth.uid];
      allow update, delete: if dona();
    }

    // Perfis da equipe: a proprietária define todos; o diretor, só os perfis comuns e nunca o próprio.
    // Cada pessoa lê apenas o próprio.
    match /equipe/{uid} {
      allow read: if dona() || eh('diretor') || (logada() && request.auth.uid == uid);
      allow write: if dona();
      allow create: if eh('diretor') && uid != request.auth.uid && papelComum(request.resource.data);
      allow update: if eh('diretor') && uid != request.auth.uid && papelComum(resource.data) && papelComum(request.resource.data);
      allow delete: if eh('diretor') && uid != request.auth.uid && papelComum(resource.data);
    }

    // Pedidos de acesso: cada pessoa cria o seu; só a proprietária e o diretor veem todos.
    match /pedidos/{uid} {
      allow read: if dona() || eh('diretor') || (logada() && request.auth.uid == uid);
      allow create, update: if logada() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'nome', 'pedidoEm']);
      allow delete: if dona() || eh('diretor');
    }

    // Atendimento do dia a dia
    match /clientes/{id} {
      allow read: if atendimento() || eh('diretor');
      allow create, update: if atendimento();
      allow delete: if dona();
    }
    match /agenda/{id} {
      allow read: if atendimento() || eh('contador') || eh('diretor');
      allow create, update: if atendimento();
      allow delete: if dona();
    }
    match /espera/{id}  { allow read, write: if atendimento(); }
    match /ideias/{id}  { allow read, write: if atendimento(); }
    match /pacotes/{id} {
      allow read: if atendimento() || eh('contador') || eh('diretor');
      allow create, update: if atendimento();
      allow delete: if dona();
    }
    match /vales/{id} {
      allow read: if atendimento() || eh('contador') || eh('diretor');
      allow create, update: if atendimento();
      allow delete: if dona();
    }

    // Dados de saúde (LGPD, dado sensível): só proprietária e trancista parceira.
    match /anamneses/{id} {
      allow read, create, update: if saude();
      allow delete: if dona();
    }

    // Estoque: proprietária e trancista parceira.
    match /estoque/{id} {
      allow read, create, update: if saude();
      allow delete: if dona();
    }

    // Aceites de contratos: não podem ser alterados depois de registrados.
    // Termos de anamnese só são visíveis para quem pode ver dados de saúde.
    match /aceites/{id} {
      allow read: if saude() || ((eh('recepcao') || eh('diretor')) && resource.data.tipo in ['servico', 'politica']);
      allow create: if saude() || ((eh('recepcao') || eh('diretor')) && request.resource.data.tipo in ['servico', 'politica']);
      allow update: if false;
      allow delete: if dona();
    }

    // Tabela de preços: só a proprietária altera. Configurações públicas (dados do negócio, Pix, política): proprietária e diretor.
    match /servicos/{id} {
      allow read: if atendimento() || eh('contador') || eh('diretor');
      allow write: if dona();
    }
    match /publico/{id} {
      allow read: if atendimento() || eh('contador') || eh('diretor');
      allow write: if finEdita();
    }

    // Finanças: proprietária e diretor alteram; contador(a) só lê.
    match /lancamentos/{id} { allow read: if financas(); allow write: if finEdita(); }
    match /contas/{id}      { allow read: if financas(); allow write: if finEdita(); }
    match /privado/{id}     { allow read: if financas(); allow write: if finEdita(); }

    // ===== Catálogo e vitrine: públicos para leitura, só a proprietária altera =====
    match /catalogo/{id} { allow read: if true; allow write: if dona(); }
    match /catalogoFotos/{id} {
      allow read: if true;
      allow create, update: if dona() && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      allow delete: if dona();
    }
    match /vitrine/{id} { allow read: if true; allow write: if dona(); }
    // Horários livres: quem atende atualiza ao mexer na agenda. Só janelas de horário e modelos, sem dados de clientes.
    match /vitrine/horarios {
      allow read: if true;
      allow write: if atendimento() && request.resource.data.keys().hasOnly(['ligado', 'dias', 'servicos', 'atualizadoEm'])
        && request.resource.data.get('dias', []) is list && request.resource.data.get('dias', []).size() <= 31
        && request.resource.data.get('servicos', []) is list && request.resource.data.get('servicos', []).size() <= 80;
    }

    // ===== Contrato por link =====
    // Quem tem o link lê o contrato. A cliente só pode aceitar uma vez, dentro da validade,
    // sem alterar nenhum outro campo. Depois do aceite, a equipe só marca "registrado" e "visto".
    match /contratosLink/{token} {
      allow get: if true;
      allow list: if contratos();
      allow create: if contratos() && request.resource.data.status == 'pendente';
      allow update: if (contratos() && (resource.data.status == 'pendente'
            ? request.resource.data.status == 'pendente'
            : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrado', 'visto'])))
        || (resource.data.status == 'pendente'
            && request.time < resource.data.expiraEm
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'aceite'])
            && request.resource.data.status == 'aceito'
            && request.resource.data.aceite.keys().hasOnly(['nome', 'cpf', 'meio', 'assinatura', 'em', 'dispositivo'])
            && request.resource.data.aceite.em == request.time
            && request.resource.data.aceite.nome is string
            && request.resource.data.aceite.nome.size() >= 3 && request.resource.data.aceite.nome.size() <= 120
            && request.resource.data.aceite.cpf is string && request.resource.data.aceite.cpf.size() <= 20
            && request.resource.data.aceite.dispositivo is string && request.resource.data.aceite.dispositivo.size() <= 200
            && request.resource.data.aceite.meio in ['assinatura', 'concordo']
            && (request.resource.data.aceite.meio == 'concordo'
                || (request.resource.data.aceite.assinatura is string && request.resource.data.aceite.assinatura.size() < 250000)));
      allow delete: if dona() || eh('diretor');
    }

    // ===== Espaço da cliente =====
    // O documento só é lido por quem tem o link (token secreto). Não é possível listar os espaços.
    match /portal/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if atendimento();
      match /proximos/{agId} {
        allow read: if true;
        allow create, delete: if atendimento();
        // A cliente só cancela antes do prazo, e só altera o campo de cancelamento.
        allow update: if atendimento()
          || (resource.data.cancelado == false
              && request.time < resource.data.limiteCancelamento
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelado', 'canceladoEm'])
              && request.resource.data.cancelado == true
              && request.resource.data.canceladoEm == request.time);
      }
    }

    // Pedidos de cancelamento feitos pela cliente, conferidos contra o prazo no servidor.
    // Também: confirmação de presença (qualquer hora antes de cancelar) e pedido de horário livre (só quem tem o link do espaço).
    function solBase(d) {
      return d.criadoEm == request.time
        && d.token is string && d.token.size() <= 64
        && d.agendaId is string && d.agendaId.size() <= 64
        && d.motivo is string && d.motivo.size() <= 300;
    }
    function proxDe(d) { return /databases/$(database)/documents/portal/$(d.token)/proximos/$(d.agendaId); }
    match /solicitacoes/{id} {
      allow create: if solBase(request.resource.data) && (
        (request.resource.data.keys().hasOnly(['token', 'agendaId', 'tipo', 'criadoEm', 'motivo'])
          && request.resource.data.tipo == 'cancelamento'
          && exists(proxDe(request.resource.data))
          && get(proxDe(request.resource.data)).data.cancelado == false
          && request.time < get(proxDe(request.resource.data)).data.limiteCancelamento)
        || (request.resource.data.keys().hasOnly(['token', 'agendaId', 'tipo', 'criadoEm', 'motivo'])
          && request.resource.data.tipo == 'confirmacao'
          && exists(proxDe(request.resource.data))
          && get(proxDe(request.resource.data)).data.cancelado == false)
        || (request.resource.data.keys().hasOnly(['token', 'agendaId', 'tipo', 'criadoEm', 'motivo', 'pedido'])
          && request.resource.data.tipo == 'horario'
          && request.resource.data.agendaId == ''
          && exists(/databases/$(database)/documents/portal/$(request.resource.data.token))
          && request.resource.data.pedido is map
          && request.resource.data.pedido.keys().hasOnly(['data', 'hora', 'servico', 'servicoId', 'duracao'])
          && request.resource.data.pedido.data is string && request.resource.data.pedido.data.size() == 10
          && request.resource.data.pedido.hora is string && request.resource.data.pedido.hora.size() == 5
          && request.resource.data.pedido.servico is string && request.resource.data.pedido.servico.size() <= 80
          && txt(request.resource.data.pedido, 'servicoId', 64)
          && request.resource.data.pedido.duracao is int && request.resource.data.pedido.duracao <= 1440)
      );
      allow read, update: if atendimento();
      allow delete: if dona();
    }

    // ===== Cadastro feito pela própria cliente =====
    // A equipe cria um convite com token secreto. Quem tem o link preenche uma única vez,
    // dentro da validade, e só os campos do formulário. A equipe revisa antes de virar ficha.
    function txt(m, k, max) { return m.get(k, '') is string && m.get(k, '').size() <= max; }
    match /cadastros/{token} {
      allow get: if true;
      allow list: if atendimento();
      allow create: if atendimento() && request.resource.data.status == 'convite';
      allow update: if atendimento()
        || (resource.data.status == 'convite'
            && request.time < resource.data.expiraEm
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dados', 'enviadoEm'])
            && request.resource.data.status == 'enviado'
            && request.resource.data.enviadoEm == request.time
            && request.resource.data.dados.keys().hasOnly(['nome', 'telefone', 'cpf', 'aniversario', 'instagram', 'origem', 'indicadaPor', 'codigoIndicacao', 'cabelo', 'obs', 'imagem', 'consentimento'])
            && request.resource.data.dados.consentimento == true
            && request.resource.data.dados.get('imagem', false) is bool
            && request.resource.data.dados.nome is string
            && request.resource.data.dados.nome.size() >= 3 && request.resource.data.dados.nome.size() <= 120
            && request.resource.data.dados.telefone is string
            && request.resource.data.dados.telefone.size() >= 8 && request.resource.data.dados.telefone.size() <= 30
            && txt(request.resource.data.dados, 'cpf', 20)
            && txt(request.resource.data.dados, 'aniversario', 10)
            && txt(request.resource.data.dados, 'instagram', 80)
            && txt(request.resource.data.dados, 'origem', 40)
            && txt(request.resource.data.dados, 'indicadaPor', 120)
            && txt(request.resource.data.dados, 'cabelo', 120)
            && txt(request.resource.data.dados, 'obs', 300)
            && txt(request.resource.data.dados, 'codigoIndicacao', 12));
      allow delete: if atendimento();
    }

    // ===== Ficha de anamnese preenchida pela cliente no espaço dela =====
    // Só quem tem o link do espaço envia. Dados de saúde: leitura apenas da proprietária e da trancista parceira.
    match /anamnesePortal/{token} {
      allow create, update: if exists(/databases/$(database)/documents/portal/$(token))
        && request.resource.data.keys().hasOnly(['respostas', 'nome', 'cpf', 'menor', 'responsavel', 'imagem', 'declaracao', 'consentimento', 'em', 'dispositivo'])
        && request.resource.data.declaracao == true
        && request.resource.data.consentimento == true
        && request.resource.data.em == request.time
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 120
        && txt(request.resource.data, 'cpf', 20)
        && txt(request.resource.data, 'dispositivo', 200)
        && request.resource.data.respostas is map && request.resource.data.respostas.size() <= 20
        && request.resource.data.menor is bool && request.resource.data.imagem is bool
        && request.resource.data.responsavel is map && request.resource.data.responsavel.size() <= 3;
      allow update: if saude()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['processado', 'resultado', 'clienteId', 'visto', 'processadoEm']);
      allow read, delete: if saude();
    }

    // ===== Avaliações feitas pela cliente no espaço dela =====
    // Uma por atendimento concluído (lista "avaliaveis" do espaço). A cliente pode editar a dela depois (nota, texto e
    // autorização); ao editar, volta para "não vista" e sai do catálogo até a equipe aprovar de novo.
    match /avaliacoes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['token', 'agendaId', 'nota', 'texto', 'autorizaPublicar', 'nomeExibicao', 'servico', 'em'])
        && request.resource.data.token is string && request.resource.data.token.size() <= 64
        && request.resource.data.agendaId is string && request.resource.data.agendaId.size() <= 64
        && id == request.resource.data.token + '_' + request.resource.data.agendaId
        && exists(/databases/$(database)/documents/portal/$(request.resource.data.token))
        && request.resource.data.agendaId in get(/databases/$(database)/documents/portal/$(request.resource.data.token)).data.avaliaveis
        && request.resource.data.nota is int && request.resource.data.nota >= 1 && request.resource.data.nota <= 5
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 600
        && request.resource.data.autorizaPublicar is bool
        && request.resource.data.nomeExibicao is string && request.resource.data.nomeExibicao.size() <= 60
        && request.resource.data.servico is string && request.resource.data.servico.size() <= 80
        && request.resource.data.em == request.time;
      allow read: if atendimento();
      allow update: if atendimento() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicado', 'visto']);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nota', 'texto', 'autorizaPublicar', 'nomeExibicao', 'editadoEm', 'visto', 'publicado'])
        && exists(/databases/$(database)/documents/portal/$(resource.data.token))
        && resource.data.agendaId in get(/databases/$(database)/documents/portal/$(resource.data.token)).data.avaliaveis
        && request.resource.data.nota is int && request.resource.data.nota >= 1 && request.resource.data.nota <= 5
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 600
        && request.resource.data.autorizaPublicar is bool
        && request.resource.data.nomeExibicao is string && request.resource.data.nomeExibicao.size() <= 60
        && request.resource.data.editadoEm == request.time
        && request.resource.data.visto == false
        && (!('publicado' in request.resource.data) || request.resource.data.publicado == false);
      allow delete: if dona();
    }

    // ===== Avisos no celular =====
    // Cada pessoa da equipe liga os avisos no próprio aparelho: guarda só os próprios tokens e preferências.
    // A rotina do GitHub lê e envia com a chave de serviço. O estado da rotina só a proprietária lê.
    match /avisos/{uid} {
      allow read, write: if (dona() || eh('diretor') || eh('parceira') || eh('recepcao') || eh('contador'))
        && request.auth.uid == uid;
      allow delete: if dona();
    }
    match /avisosEstado/{id} { allow read: if dona(); }

    // ===== Erros nos aparelhos (app.js, "erros nos aparelhos") =====
    // Cada pessoa da equipe grava só os próprios, com campos curtos. Só a proprietária e o diretor leem e apagam.
    match /erros/{id} {
      allow read, delete: if dona() || eh('diretor');
      allow create: if (dona() || eh('diretor') || eh('parceira') || eh('recepcao') || eh('contador'))
        && request.resource.data.keys().hasOnly(['quando', 'uid', 'msg', 'onde', 'tela', 'versao', 'aparelho', 'vezes'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.quando == request.time
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && txt(request.resource.data, 'onde', 200)
        && txt(request.resource.data, 'tela', 40)
        && txt(request.resource.data, 'versao', 40)
        && txt(request.resource.data, 'aparelho', 200)
        && request.resource.data.get('vezes', 1) is int && request.resource.data.get('vezes', 1) <= 1000;
      allow update: if false;
    }

    // ===== Jurídico =====
    // Documentos da empresa, contratos com terceiros, lista da LGPD e versões da política: proprietária e diretor.
    match /juridico/{id} { allow read, write: if finEdita(); }

    // ===== Registro de alterações (quem alterou o quê) =====
    // Cada pessoa da equipe grava só em nome próprio, na hora do servidor. Ninguém altera nem apaga.
    // Só a proprietária e o diretor leem.
    match /registro/{id} {
      allow read: if finEdita();
      allow create: if (dona() || eh('diretor') || eh('parceira') || eh('recepcao'))
        && request.resource.data.keys().hasOnly(['quem', 'nome', 'col', 'docId', 'acao', 'resumo', 'em'])
        && request.resource.data.quem == request.auth.uid
        && request.resource.data.em == request.time
        && request.resource.data.acao in ['criou', 'alterou', 'excluiu']
        && txt(request.resource.data, 'nome', 80)
        && txt(request.resource.data, 'col', 40)
        && txt(request.resource.data, 'docId', 120)
        && request.resource.data.resumo is string && request.resource.data.resumo.size() <= 400;
      allow update, delete: if false;
    }

    // Qualquer outro caminho é bloqueado.
    match /{documento=**} { allow read, write: if false; }
  }
}
